<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'Seralyth temp' and '$(CI)'!='TRUE' and '$(PluginsPath)'!='' and Exists('$(PluginsPath)')">
		<Delete Files="$(PluginsPath)\Seralyth temp.dll" />
		<Delete Files="$(PluginsPath)\Seralyth temp Legal.dll" />
		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginsPath)\$(TargetFileName)" />
		<Message Text="Copied to Plugins" Importance="high"/>
	</Target>

	<Target Name="BuildSibling" AfterTargets="Build" Condition="'$(SiblingProject)'!='' and '$(CurrentSolutionConfigurationContents)'=='' and '$(SiblingBuildDone)'!='true'">
		<MSBuild Projects="$(SiblingProject)" Targets="Build" Properties="SiblingBuildDone=true;Configuration=$(Configuration);CI=$(CI)" />
		<Message Text="Built sibling project $(SiblingProject)" Importance="high"/>
	</Target>
</Project>
